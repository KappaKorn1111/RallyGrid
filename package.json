{"name":"rallygrid","private":true,"version":"0.1.0","packageManager":"pnpm@10.22.0","engines":{"node":">=22","pnpm":">=10"},"scripts":{"dev":"pnpm --parallel --filter @rallygrid/web --filter @rallygrid/server dev","dev:web":"pnpm --filter @rallygrid/web dev --host 0.0.0.0","dev:server":"pnpm --filter @rallygrid/server dev","build":"pnpm -r build","typecheck":"pnpm --filter @rallygrid/game-core build && pnpm -r typecheck","lint":"eslint .","format":"prettier --write .","format:check":"prettier --check .","test":"vitest run --config vitest.config.ts","test:watch":"vitest --config vitest.config.ts","test:e2e":"playwright test","infra:up":"docker compose up -d postgres redis","infra:down":"docker compose down","db:generate":"pnpm --filter @rallygrid/server db:generate","db:migrate":"pnpm --filter @rallygrid/server db:migrate"},"devDependencies":{"@eslint/js":"^9.39.1","@playwright/test":"^1.56.1","eslint":"^9.39.1","eslint-config-prettier":"^10.1.8","globals":"^16.5.0","prettier":"^3.6.2","typescript":"^5.9.3","typescript-eslint":"^8.46.4","vitest":"^3.2.4"}}